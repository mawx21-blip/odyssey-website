# ==========================================================================
# ODYSSEY LAWN CARE — URL CLEANUP REDIRECTS
# Added 2026-04-29 — handles old site retirement + v2 URL flattening
# ==========================================================================

# ---- v2- prefix retirement (rebuild URLs to clean URLs) ----
Redirect 301 /v2-lawn-mowing/ https://odysseylawncarellc.com/lawn-mowing/
Redirect 301 /v2-bush-trimming-removal/ https://odysseylawncarellc.com/bush-trimming-removal/
Redirect 301 /v2-mulch-installation/ https://odysseylawncarellc.com/mulch-installation/
Redirect 301 /v2-flowerbed-maintenance/ https://odysseylawncarellc.com/flowerbed-maintenance/
Redirect 301 /v2-leaf-cleanup/ https://odysseylawncarellc.com/leaf-cleanup/
Redirect 301 /v2-christmas-lights/ https://odysseylawncarellc.com/christmas-lights/
Redirect 301 /v2-southaven-ms/ https://odysseylawncarellc.com/southaven-ms/
Redirect 301 /v2-olive-branch-ms/ https://odysseylawncarellc.com/olive-branch-ms/
Redirect gone /v2-horn-lake-ms/
Redirect 301 /v2-about-us/ https://odysseylawncarellc.com/about-us/
Redirect 301 /v2-faq/ https://odysseylawncarellc.com/faq/
Redirect 301 /v2-contact-us/ https://odysseylawncarellc.com/contact-us/

# ---- Pretty URLs: serve /lawn-mowing/ from /lawn-mowing.html ----
# This lets you keep flat .html files but expose clean URLs.
RewriteEngine On

# ---- www -> non-www (added 2026-11-14) ----
RewriteCond %{HTTP_HOST} ^www\.odysseylawncarellc\.com$ [NC]
RewriteRule ^(.*)$ https://odysseylawncarellc.com/$1 [R=301,L]

# Redirect /page.html → /page/ (so visitors and Google see the clean URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1/ [R=301,L]

# Internally serve /folder/ from /folder.html if the file exists
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteCond %{REQUEST_URI} ^/([^.]+)/$
RewriteRule ^(.+)/$ /$1.html [L]

# ---- Retired page: Horn Lake is intentionally gone (410) ----
Redirect gone /horn-lake-ms/

# ---- Long cache for images and fonts (added 2026-11-14) ----
# These files are cached for a year. If you ever replace a photo, upload it under a
# NEW file name (and update the page), or returning visitors keep seeing the old one.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ==========================================================================
# END ODYSSEY URL CLEANUP
# ==========================================================================